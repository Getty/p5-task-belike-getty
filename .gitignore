/Task-BeLike-GETTY-*
.build
# Claude Code — commit: skills/, settings.json, skilletor.json
# Ignore: local overrides, credentials, session data
.claude/*.local.*
.claude/local/
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/
# skilletor: committe Config + Ignore-Block
!.claude/skilletor.json
!.claude/.gitignore
# Claude Code worktrees (claude --worktree / isolated agents) -- never commit
/.claude/worktrees/
